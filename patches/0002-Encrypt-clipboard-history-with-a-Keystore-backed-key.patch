+package org.fcitx.fcitx5.android.data.clipboard.crypto
+
+import android.content.Context
+import android.os.Build
+import android.security.keystore.KeyGenParameterSpec
+import android.security.keystore.KeyInfo
+import android.security.keystore.KeyPermanentlyInvalidatedException
+import android.security.keystore.KeyProperties
+import android.util.Base64
+import timber.log.Timber
+import java.io.File
+import java.security.KeyStore
+import java.security.ProviderException
+import java.security.SecureRandom
+import javax.crypto.BadPaddingException
+import javax.crypto.Cipher
+import javax.crypto.KeyGenerator
+import javax.crypto.Mac
+import javax.crypto.SecretKey
+import javax.crypto.SecretKeyFactory
+import javax.crypto.spec.GCMParameterSpec
+import javax.crypto.spec.SecretKeySpec
+
+/**
+ * Envelope encryption for the clipboard history.
+ *
+ * - A non-exportable AES-256 *master key* lives in the Android Keystore (StrongBox when the
+ *   device has one, otherwise the TEE) and is only ever used to wrap and unwrap the data keys.
+ * - The *data keys* (an AES-256-GCM key for entries and an HMAC-SHA256 key for de-duplication)
+ *   are random, stored wrapped by the master key in the no-backup directory, and unwrapped once
+ *   per process. Doing every entry in the secure hardware would make scrolling the history
+ *   unusably slow (a StrongBox operation takes tens of milliseconds).
+ *
+ * Consequences: the stored data is useless without this device's secure hardware (it is not
+ * restorable from a backup and cannot be read by pulling the files off a rooted/imaged device),
+ * but while the process runs, the unwrapped data keys are in its memory.
+ */
+object ClipboardCrypto {
+
+    private const val ANDROID_KEYSTORE = "AndroidKeyStore"
+    private const val MASTER_KEY_ALIAS_PREFIX = "fcitx5_clipboard_master_v1"
+    private const val KEY_FILE = "clipboard_keys_v1"
+    private const val TRANSFORMATION = "AES/GCM/NoPadding"
+    private const val IV_SIZE = 12
+    private const val TAG_BITS = 128
+    private const val CIPHER_KEY_SIZE = 32
+    private const val MAC_KEY_SIZE = 32
+
+    class DataKeys internal constructor(
+        internal val cipherKey: SecretKey,
+        internal val macKey: SecretKey,
+        /**
+         * true when the keys were generated just now, which means that anything encrypted with
+         * previous keys (if any) can never be decrypted again
+         */
+        val isNew: Boolean
+    )
+
+    private val random = SecureRandom()
+
+    @Volatile
+    private var cached: DataKeys? = null
+
+    /**
+     * Keys that are already unwrapped. Never touches the Keystore, safe to call on the main thread.
+     */
+    fun keysIfReady(): DataKeys? = cached
+
+    /**
+     * Unwrap (or create) the data keys. This talks to the Keystore, so don't call it on the main thread.
+     * Returns null when the Keystore is not usable right now (e.g. device is locked), in which case
+     * nothing is lost and the call can be retried later.
+     */
+    @Synchronized
+    fun keys(context: Context): DataKeys? {
+        cached?.let { return it }
+        return try {
+            loadOrCreate(context).also { cached = it }
+        } catch (e: Exception) {
+            Timber.w(e, "Clipboard keys are not available now")
+            null
+        }
+    }
+
+    fun encrypt(keys: DataKeys, plain: String): String {
+        val iv = ByteArray(IV_SIZE).also(random::nextBytes)
+        val cipher = Cipher.getInstance(TRANSFORMATION)
+        cipher.init(Cipher.ENCRYPT_MODE, keys.cipherKey, GCMParameterSpec(TAG_BITS, iv))
+        val encrypted = cipher.doFinal(plain.toByteArray(Charsets.UTF_8))
+        return Base64.encodeToString(iv + encrypted, Base64.NO_WRAP)
+    }
+
+    /**
+     * @throws java.security.GeneralSecurityException on tampered or undecryptable data
+     */
+    fun decrypt(keys: DataKeys, encoded: String): String {
+        val blob = Base64.decode(encoded, Base64.NO_WRAP)
+        // an empty text is exactly IV + tag
+        require(blob.size >= IV_SIZE + TAG_BITS / 8) { "truncated clipboard entry" }
+        val cipher = Cipher.getInstance(TRANSFORMATION)
+        cipher.init(Cipher.DECRYPT_MODE, keys.cipherKey, GCMParameterSpec(TAG_BITS, blob, 0, IV_SIZE))
+        return String(cipher.doFinal(blob, IV_SIZE, blob.size - IV_SIZE), Charsets.UTF_8)
+    }
+
+    /**
+     * Keyed hash used to look entries up without storing their plaintext, equal texts give equal hashes.
+     */
+    fun hash(keys: DataKeys, plain: String): String {
+        val mac = Mac.getInstance("HmacSHA256").apply { init(keys.macKey) }
+        return Base64.encodeToString(mac.doFinal(plain.toByteArray(Charsets.UTF_8)), Base64.NO_WRAP)
+    }
+
+    private fun masterKeyAlias(context: Context): String {
+        // device protected (direct boot) and credential protected storage have their own key files,
+        // so they must not share (and thereby clobber) one master key
+        val deviceProtected =
+            Build.VERSION.SDK_INT >= Build.VERSION_CODES.N && context.isDeviceProtectedStorage
+        return if (deviceProtected) "${MASTER_KEY_ALIAS_PREFIX}_de" else "${MASTER_KEY_ALIAS_PREFIX}_ce"
+    }
+
+    private fun loadOrCreate(context: Context): DataKeys {
+        val alias = masterKeyAlias(context)
+        val file = File(context.noBackupFilesDir, KEY_FILE)
+        val keyStore = KeyStore.getInstance(ANDROID_KEYSTORE).apply { load(null) }
+        var resetMaster = false
+        if (file.exists() && keyStore.containsAlias(alias)) {
+            try {
+                return unwrap(keyStore, alias, file.readBytes())
+            } catch (e: KeyPermanentlyInvalidatedException) {
+                // e.g. the lock screen was removed. The master key is gone for good
+                Timber.w(e, "Clipboard master key was invalidated")
+                resetMaster = true
+            } catch (e: BadPaddingException) {
+                // wrapped by a different master key, or corrupted
+                Timber.w(e, "Clipboard data keys cannot be unwrapped")
+            } catch (e: IllegalArgumentException) {
+                Timber.w(e, "Clipboard data key file is corrupted")
+            }
+            // any other exception is possibly temporary (Keystore busy or device locked) and propagates
+        }
+        return create(keyStore, alias, file, resetMaster)
+    }
+
+    private fun unwrap(keyStore: KeyStore, alias: String, blob: ByteArray): DataKeys {
+        require(blob.size > IV_SIZE + TAG_BITS / 8) { "truncated key file" }
+        val master = keyStore.getKey(alias, null) as? SecretKey
+            ?: throw IllegalArgumentException("master key is missing")
+        val cipher = Cipher.getInstance(TRANSFORMATION)
+        cipher.init(Cipher.DECRYPT_MODE, master, GCMParameterSpec(TAG_BITS, blob, 0, IV_SIZE))
+        val raw = cipher.doFinal(blob, IV_SIZE, blob.size - IV_SIZE)
+        require(raw.size == CIPHER_KEY_SIZE + MAC_KEY_SIZE) { "unexpected key file content" }
+        return try {
+            toDataKeys(raw, isNew = false)
+        } finally {
+            raw.fill(0)
+        }
+    }
+
+    private fun create(keyStore: KeyStore, alias: String, file: File, resetMaster: Boolean): DataKeys {
+        if (resetMaster) keyStore.deleteEntry(alias)
+        val master = (try {
+            keyStore.getKey(alias, null) as? SecretKey
+        } catch (e: KeyPermanentlyInvalidatedException) {
+            keyStore.deleteEntry(alias)
+            null
+        }) ?: generateMasterKey(alias)
+        logSecurityLevel(master)
+        val raw = ByteArray(CIPHER_KEY_SIZE + MAC_KEY_SIZE).also(random::nextBytes)
+        try {
+            val cipher = Cipher.getInstance(TRANSFORMATION)
+            // the Keystore picks the IV, see setRandomizedEncryptionRequired
+            cipher.init(Cipher.ENCRYPT_MODE, master)
+            val blob = cipher.iv + cipher.doFinal(raw)
+            val tmp = File(file.parentFile, "$KEY_FILE.tmp")
+            tmp.writeBytes(blob)
+            if (!tmp.renameTo(file)) {
+                tmp.delete()
+                throw java.io.IOException("Cannot write clipboard key file")
+            }
+            return toDataKeys(raw, isNew = true)
+        } finally {
+            raw.fill(0)
+        }
+    }
+
+    private fun toDataKeys(raw: ByteArray, isNew: Boolean) = DataKeys(
+        // SecretKeySpec copies the bytes
+        SecretKeySpec(raw, 0, CIPHER_KEY_SIZE, "AES"),
+        SecretKeySpec(raw, CIPHER_KEY_SIZE, MAC_KEY_SIZE, "HmacSHA256"),
+        isNew
+    )
+
+    private fun generateMasterKey(alias: String): SecretKey {
+        // preferred first: StrongBox + only usable while the device is unlocked
+        val attempts = buildList {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                add(true to true)
+                add(false to true)
+            }
+            add(false to false)
+        }
+        var last: Exception? = null
+        for ((strongBox, unlockedOnly) in attempts) {
+            try {
+                val builder = KeyGenParameterSpec.Builder(
+                    alias,
+                    KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT
+                )
+                    .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                    .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                    .setKeySize(256)
+                    .setRandomizedEncryptionRequired(true)
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                    if (unlockedOnly) builder.setUnlockedDeviceRequired(true)
+                    if (strongBox) builder.setIsStrongBoxBacked(true)
+                }
+                return KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, ANDROID_KEYSTORE)
+                    .apply { init(builder.build()) }
+                    .generateKey()
+            } catch (e: ProviderException) {
+                // includes StrongBoxUnavailableException
+                last = e
+            } catch (e: java.security.InvalidAlgorithmParameterException) {
+                last = e
+            }
+        }
+        throw IllegalStateException("Cannot generate clipboard master key", last)
+    }
+
+    @Suppress("DEPRECATION")
+    private fun logSecurityLevel(key: SecretKey) {
+        runCatching {
+            val info = SecretKeyFactory.getInstance(key.algorithm, ANDROID_KEYSTORE)
+                .getKeySpec(key, KeyInfo::class.java) as KeyInfo
+            val level = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                when (info.securityLevel) {
+                    KeyProperties.SECURITY_LEVEL_STRONGBOX -> "StrongBox"
+                    KeyProperties.SECURITY_LEVEL_TRUSTED_ENVIRONMENT -> "TEE"
+                    KeyProperties.SECURITY_LEVEL_SOFTWARE -> "software"
+                    else -> "unknown"
+                }
+            } else if (info.isInsideSecureHardware) {
+                "secure hardware"
+            } else {
+                "software"
+            }
+            Timber.i("Clipboard master key security level: $level")
+        }
+    }
+}
