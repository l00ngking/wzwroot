+++ b/app/src/main/java/org/fcitx/fcitx5/android/input/keyboard/GlassRefraction.kt
@@ -0,0 +1,236 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2025 Fcitx5 for Android Contributors
