diff --git a/app/src/main/java/org/fcitx/fcitx5/android/input/TabletLayout.kt b/app/src/main/java/org/fcitx/fcitx5/android/input/TabletLayout.kt
new file mode 100644
index 0000000..4102d55
--- /dev/null
+++ b/app/src/main/java/org/fcitx/fcitx5/android/input/TabletLayout.kt
@@ -0,0 +1,67 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2025 Fcitx5 for Android Contributors
+ */
+
+package org.fcitx.fcitx5.android.input
+
+import android.content.Context
+import org.fcitx.fcitx5.android.data.theme.ThemeManager
+import org.fcitx.fcitx5.android.data.theme.ThemePrefs.TabletMode
+import org.fcitx.fcitx5.android.input.bar.KawaiiBarComponent
+import splitties.dimensions.dp
+import kotlin.math.min
+
+/**
+ * Sizes for large screens (tablets, unfolded foldables).
+ *
+ * The phone layout stretches to the full width, which on a 10" tablet in landscape gives keys that
+ * are more than 100dp wide and a keyboard that is out of thumb reach. Here the keyboard is limited
+ * to [ThemePrefs.tabletMaxWidth][org.fcitx.fcitx5.android.data.theme.ThemePrefs.tabletMaxWidth] and
+ * centered, and everything that is measured in dp (labels, candidate bar, key popups) is scaled up.
+ */
+object TabletLayout {
+
+    private const val LARGE_SMALLEST_WIDTH_DP = 600
+    private const val SCALE = 1.2f
+    private const val BAR_HEIGHT_DP = 48
+    private const val MIN_KEYS_HEIGHT_DP = 240
+    private const val MAX_KEYS_HEIGHT_DP = 340
+
+    fun isLarge(context: Context): Boolean = when (ThemeManager.prefs.tabletMode.getValue()) {
+        TabletMode.Auto -> context.resources.configuration.smallestScreenWidthDp >= LARGE_SMALLEST_WIDTH_DP
+        TabletMode.On -> true
+        TabletMode.Off -> false
+    }
+
+    /**
+     * Factor for sizes that are given in dp or sp
+     */
+    fun scale(context: Context): Float = if (isLarge(context)) SCALE else 1f
+
+    fun barHeightDp(context: Context): Int =
+        if (isLarge(context)) BAR_HEIGHT_DP else KawaiiBarComponent.HEIGHT
+
+    /**
+     * Padding to add on each side so that the keyboard is not wider than the maximum width.
+     */
+    fun extraSidePaddingPx(context: Context, viewWidthPx: Int, userSidePaddingPx: Int): Int {
+        if (!isLarge(context) || viewWidthPx <= 0) return 0
+        val maxWidth = context.dp(ThemeManager.prefs.tabletMaxWidth.getValue())
+        val available = viewWidthPx - 2 * userSidePaddingPx
+        return if (available > maxWidth) (available - maxWidth) / 2 else 0
+    }
+
+    /**
+     * The height from the percentage preference is relative to the screen height. In landscape that
+     * is a keyboard that covers half of a tablet, and a 900dp wide keyboard with such rows has keys
+     * that are wider than tall; in portrait on a big tablet it is too tall as well. Keys of about
+     * 85dp, close to square, are comfortable, so the height is kept between 240dp and 340dp.
+     */
+    fun keysHeightPx(context: Context, fromPercentPx: Int, screenHeightPx: Int): Int {
+        if (!isLarge(context)) return fromPercentPx
+        val atMost = min(context.dp(MAX_KEYS_HEIGHT_DP), (screenHeightPx * 0.55f).toInt())
+        val atLeast = min(context.dp(MIN_KEYS_HEIGHT_DP), atMost)
+        return fromPercentPx.coerceIn(atLeast, atMost)
+    }
+}
