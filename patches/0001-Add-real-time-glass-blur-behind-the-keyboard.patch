diff --git a/app/src/main/java/org/fcitx/fcitx5/android/input/GlassBackdrop.kt b/app/src/main/java/org/fcitx/fcitx5/android/input/GlassBackdrop.kt
new file mode 100644
index 0000000..05ad5b8
--- /dev/null
+++ b/app/src/main/java/org/fcitx/fcitx5/android/input/GlassBackdrop.kt
@@ -0,0 +1,166 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2025 Fcitx5 for Android Contributors
+ */
+
+package org.fcitx.fcitx5.android.input
+
+import android.graphics.Color
+import android.graphics.drawable.ColorDrawable
+import android.graphics.drawable.LayerDrawable
+import android.os.Build
+import android.view.Gravity
+import android.view.View
+import android.view.ViewTreeObserver
+import android.view.WindowManager
+import android.widget.PopupWindow
+import androidx.annotation.RequiresApi
+import androidx.core.graphics.ColorUtils
+import org.fcitx.fcitx5.android.data.theme.Theme
+import timber.log.Timber
+import java.util.function.Consumer
+
+/**
+ * Real-time "liquid glass" backdrop: blurs whatever is *behind* the keyboard.
+ *
+ * The IME window is full screen (it has to be, key popups and the floating candidates view
+ * are drawn outside of the keyboard), so `Window#setBackgroundBlurRadius` on it would blur the
+ * whole screen. Instead we put a non-touchable sub-window of type
+ * [WindowManager.LayoutParams.TYPE_APPLICATION_MEDIA] exactly under [target]. Such a window is
+ * z-ordered *below* the IME window, so keys are drawn on top of the blur, and `blurBehindRadius`
+ * on it only affects its own rectangle.
+ *
+ * The backdrop is only active while cross-window blur is available (Android 12+, not disabled by
+ * battery saver or the vendor). Whenever its state changes, [onActiveChanged] is called so that the
+ * caller can show the static theme background instead (as the fallback).
+ */
+@RequiresApi(Build.VERSION_CODES.S)
+class GlassBackdrop(
+    private val anchor: View,
+    private val target: View,
+    private val theme: Theme,
+    private val blurRadiusPx: Int,
+    private val onActiveChanged: (Boolean) -> Unit
+) {
+
+    private val context = anchor.context
+    private val windowManager = context.getSystemService(WindowManager::class.java)
+
+    private val popup = PopupWindow(context).apply {
+        // the sub-window must never take focus or touches, or it would steal them from the IME window
+        isFocusable = false
+        isTouchable = false
+        isClippingEnabled = false
+        inputMethodMode = PopupWindow.INPUT_METHOD_NOT_NEEDED
+        elevation = 0f
+        setBackgroundDrawable(null)
+        windowLayoutType = WindowManager.LayoutParams.TYPE_APPLICATION_MEDIA
+        contentView = View(context).apply { background = tintDrawable() }
+    }
+
+    private var started = false
+    private var crossWindowBlurEnabled = false
+    private var active = false
+
+    // last applied geometry: x, y, width, height
+    private val rect = intArrayOf(-1, -1, -1, -1)
+    private val location = intArrayOf(0, 0)
+
+    private fun tintDrawable(): LayerDrawable {
+        val base = ColorUtils.setAlphaComponent(
+            theme.keyboardColor, if (theme.isDark) 0x8C else 0x99
+        )
+        val rim = ColorUtils.setAlphaComponent(Color.WHITE, if (theme.isDark) 0x33 else 0x99)
+        return LayerDrawable(arrayOf(ColorDrawable(base), ColorDrawable(rim))).apply {
+            // 1dp specular rim along the top edge
+            setLayerGravity(1, Gravity.TOP or Gravity.FILL_HORIZONTAL)
+            setLayerHeight(1, context.resources.displayMetrics.density.toInt().coerceAtLeast(1))
+        }
+    }
+
+    private val crossWindowBlurListener = Consumer<Boolean> { enabled ->
+        crossWindowBlurEnabled = enabled
+        anchor.post { sync() }
+    }
+
+    private val layoutListener = ViewTreeObserver.OnGlobalLayoutListener { sync() }
+
+    fun start() {
+        if (started) return
+        started = true
+        crossWindowBlurEnabled = windowManager.isCrossWindowBlurEnabled
+        windowManager.addCrossWindowBlurEnabledListener(anchor.context.mainExecutor, crossWindowBlurListener)
+        anchor.viewTreeObserver.addOnGlobalLayoutListener(layoutListener)
+        anchor.post { sync() }
+    }
+
+    fun stop() {
+        if (!started) return
+        started = false
+        windowManager.removeCrossWindowBlurEnabledListener(crossWindowBlurListener)
+        if (anchor.viewTreeObserver.isAlive) {
+            anchor.viewTreeObserver.removeOnGlobalLayoutListener(layoutListener)
+        }
+        hide()
+        setActive(false)
+    }
+
+    private fun setActive(value: Boolean) {
+        if (active == value) return
+        active = value
+        onActiveChanged(value)
+    }
+
+    private fun hide() {
+        rect.fill(-1)
+        if (popup.isShowing) popup.dismiss()
+    }
+
+    private fun sync() {
+        if (!started) return
+        val shouldShow = crossWindowBlurEnabled && anchor.isAttachedToWindow &&
+                anchor.windowToken != null && target.isShown &&
+                target.width > 0 && target.height > 0
+        if (!shouldShow) {
+            hide()
+            setActive(false)
+            return
+        }
+        try {
+            target.getLocationInWindow(location)
+            val x = location[0]
+            val y = location[1]
+            val w = target.width
+            val h = target.height
+            if (!popup.isShowing) {
+                popup.width = w
+                popup.height = h
+                popup.showAtLocation(anchor, Gravity.TOP or Gravity.START, x, y)
+                rect[0] = x; rect[1] = y; rect[2] = w; rect[3] = h
+                applyBlur()
+            } else if (rect[0] != x || rect[1] != y || rect[2] != w || rect[3] != h) {
+                popup.update(x, y, w, h)
+                rect[0] = x; rect[1] = y; rect[2] = w; rect[3] = h
+                applyBlur()
+            }
+            setActive(true)
+        } catch (e: RuntimeException) {
+            // e.g. WindowManager.BadTokenException when the IME window is going away
+            Timber.w(e, "Failed to show glass backdrop, falling back to static background")
+            hide()
+            setActive(false)
+        }
+    }
+
+    @Suppress("DEPRECATION")
+    private fun applyBlur() {
+        val root = popup.contentView?.rootView ?: return
+        val lp = root.layoutParams as? WindowManager.LayoutParams ?: return
+        if (lp.blurBehindRadius == blurRadiusPx &&
+            (lp.flags and WindowManager.LayoutParams.FLAG_BLUR_BEHIND) != 0
+        ) return
+        lp.flags = lp.flags or WindowManager.LayoutParams.FLAG_BLUR_BEHIND
+        lp.blurBehindRadius = blurRadiusPx
+        windowManager.updateViewLayout(root, lp)
+    }
+}
