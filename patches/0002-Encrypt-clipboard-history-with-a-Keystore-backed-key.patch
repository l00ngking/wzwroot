+package org.fcitx.fcitx5.android.data.clipboard.db
+
+import android.content.ClipDescription
+import androidx.room.ColumnInfo
+import androidx.room.Entity
+import androidx.room.PrimaryKey
+
+/**
+ * A row of the clipboard table, i.e. what is persisted. [ClipboardEntry] is the plaintext
+ * counterpart that the rest of the app works with.
+ */
+@Entity(tableName = ClipboardRecord.TABLE_NAME)
+data class ClipboardRecord(
+    @PrimaryKey(autoGenerate = true)
+    val id: Int = 0,
+    /**
+     * base64(iv + AES-GCM ciphertext) when [encrypted] is true,
+     * otherwise plaintext of a row written by an older version, which is encrypted on startup
+     */
+    val text: String,
+    val pinned: Boolean = false,
+    @ColumnInfo(defaultValue = "-1")
+    val timestamp: Long = System.currentTimeMillis(),
+    @ColumnInfo(defaultValue = ClipDescription.MIMETYPE_TEXT_PLAIN)
+    val type: String = ClipDescription.MIMETYPE_TEXT_PLAIN,
+    @ColumnInfo(defaultValue = "0")
+    val deleted: Boolean = false,
+    @ColumnInfo(defaultValue = "0")
+    val sensitive: Boolean = false,
+    @ColumnInfo(defaultValue = "0")
+    val encrypted: Boolean = false,
+    /**
+     * HMAC of the plaintext, only used to find duplicates. null for rows not encrypted yet
+     */
+    val textHash: String? = null
+) {
+    companion object {
+        const val TABLE_NAME = "clipboard"
+    }
+}
