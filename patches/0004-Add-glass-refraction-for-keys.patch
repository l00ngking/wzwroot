+
+package org.fcitx.fcitx5.android.input.keyboard
+
+import android.graphics.Bitmap
+import android.graphics.BitmapShader
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.PointF
+import android.graphics.Rect
+import android.graphics.RectF
+import android.graphics.RuntimeShader
+import android.graphics.Shader
+import android.graphics.drawable.Drawable
+import android.os.Build
+import android.view.View
+import androidx.annotation.RequiresApi
+import timber.log.Timber
+import java.util.Collections
+import java.util.WeakHashMap
+import kotlin.math.max
+
+/**
+ * Keys cannot refract what is behind the keyboard window (other apps' content is not readable),
+ * but they can refract the keyboard's own background image. [RefractionSource] renders that image
+ * into a bitmap the size of the keyboard, and [RefractionPainter] lets every key sample it through
+ * a lens shader.
+ *
+ * KeyViews are created while InputView is being constructed, long before any layout, hence the
+ * process wide handle. InputView sets it before creating the keyboard and clears it on detach.
+ */
+object GlassRefraction {
+    @Volatile
+    var source: RefractionSource? = null
+}
+
+class RefractionSource(private val background: Drawable) {
+
+    var bitmap: Bitmap? = null
+        private set
+
+    private var anchor: View? = null
+    private val anchorLocation = IntArray(2)
+    private val hostLocation = IntArray(2)
+    private val dependants = Collections.newSetFromMap(WeakHashMap<Drawable, Boolean>())
+
+    private val layoutListener = View.OnLayoutChangeListener { _, l, t, r, b, ol, ot, orr, ob ->
+        if (r - l != orr - ol || b - t != ob - ot) rebuild(r - l, b - t)
+    }
+
+    /**
+     * @param view the view the background image fills, in InputView it is the keyboard view
+     */
+    fun attach(view: View) {
+        anchor = view
+        view.addOnLayoutChangeListener(layoutListener)
+        if (view.width > 0 && view.height > 0) rebuild(view.width, view.height)
+    }
+
+    fun detach() {
+        anchor?.removeOnLayoutChangeListener(layoutListener)
+        anchor = null
+        bitmap = null
+    }
+
+    /**
+     * Drawables to redraw when the bitmap changes, since a key does not repaint by itself
+     */
+    fun register(drawable: Drawable) {
+        dependants.add(drawable)
+    }
+
+    /**
+     * Where the top left corner of [host] is, in the coordinates of the bitmap
+     */
+    fun originOf(host: View, out: PointF): Boolean {
+        val a = anchor ?: return false
+        a.getLocationInWindow(anchorLocation)
+        host.getLocationInWindow(hostLocation)
+        out.set(
+            (hostLocation[0] - anchorLocation[0]).toFloat(),
+            (hostLocation[1] - anchorLocation[1]).toFloat()
+        )
+        return true
+    }
+
+    private fun rebuild(w: Int, h: Int) {
+        if (w <= 0 || h <= 0) return
+        val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bmp)
+        // the drawable is shared with the ImageView that shows it, put its bounds back afterwards
+        val savedBounds = Rect(background.bounds)
+        try {
+            val dw = background.intrinsicWidth
+            val dh = background.intrinsicHeight
+            if (dw <= 0 || dh <= 0) {
+                background.setBounds(0, 0, w, h)
+                background.draw(canvas)
+            } else {
+                // same as ImageView.ScaleType.CENTER_CROP
+                val scale = max(w / dw.toFloat(), h / dh.toFloat())
+                canvas.translate((w - dw * scale) / 2f, (h - dh * scale) / 2f)
+                canvas.scale(scale, scale)
+                background.setBounds(0, 0, dw, dh)
+                background.draw(canvas)
+            }
+        } finally {
+            background.bounds = savedBounds
+        }
+        bitmap = bmp
+        dependants.toList().forEach { it.invalidateSelf() }
+    }
+}
+
+/**
+ * Draws the body of a [GlassKeyDrawable]. Returns false when it cannot (yet), then the drawable
+ * falls back to its plain translucent body.
+ */
+fun interface GlassBodyPainter {
+    fun drawBody(canvas: Canvas, rect: RectF, radius: Float, paint: Paint): Boolean
+}
+
+/**
+ * A thick convex lens over the background image:
+ *
+ * - inside the key it is almost flat, with a slight magnification,
+ * - within [BEVEL_DP] of the edge the sample point is pushed outwards, more and more towards the rim,
+ *   so that the background appears to bend over the edge,
+ * - red, green and blue are pushed by slightly different amounts (dispersion), which gives the
+ *   colored fringes that real glass has,
+ * - the very rim is a little darker, it reads as thickness.
+ *
+ * The same formulas are in tools/render_blur_demo.py, which draws the preview images. Keep them in sync.
+ */
+@RequiresApi(Build.VERSION_CODES.TIRAMISU)
+class RefractionPainter(
+    private val source: RefractionSource,
+    private val host: View,
+    private val density: Float,
+    owner: Drawable
+) : GlassBodyPainter {
+
+    private val shader: RuntimeShader? = try {
+        RuntimeShader(AGSL)
+    } catch (e: RuntimeException) {
+        Timber.w(e, "Glass refraction shader does not compile, keys are drawn without refraction")
+        null
+    }
+
+    private var bitmapShader: BitmapShader? = null
+    private var boundBitmap: Bitmap? = null
+    private val origin = PointF()
+
+    init {
+        source.register(owner)
+    }
+
+    override fun drawBody(canvas: Canvas, rect: RectF, radius: Float, paint: Paint): Boolean {
+        val rt = shader ?: return false
+        val bmp = source.bitmap ?: return false
+        if (!source.originOf(host, origin)) return false
+        if (bmp !== boundBitmap) {
+            val bs = BitmapShader(bmp, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
+            rt.setInputShader("backdrop", bs)
+            bitmapShader = bs
+            boundBitmap = bmp
+        }
+        rt.setFloatUniform("box", rect.left, rect.top, rect.right, rect.bottom)
+        rt.setFloatUniform("radius", radius)
+        rt.setFloatUniform("bevel", BEVEL_DP * density)
+        rt.setFloatUniform("strength", STRENGTH_DP * density)
+        rt.setFloatUniform("aberration", ABERRATION)
+        rt.setFloatUniform("zoom", ZOOM)
+        rt.setFloatUniform("rimShade", RIM_SHADE)
+        rt.setFloatUniform("offset", origin.x, origin.y)
+        paint.shader = rt
+        canvas.drawRoundRect(rect, radius, radius, paint)
+        paint.shader = null
+        return true
+    }
+
+    companion object {
+        const val BEVEL_DP = 14f
+        const val STRENGTH_DP = 11f
+        const val ABERRATION = 0.06f
+        const val ZOOM = 0.97f
+        const val RIM_SHADE = 0.10f
+
+        private const val AGSL = """
+uniform shader backdrop;
+uniform float4 box;
+uniform float radius;
+uniform float bevel;
+uniform float strength;
+uniform float aberration;
+uniform float zoom;
+uniform float rimShade;
+uniform float2 offset;
+
+float2 outwardNormal(float2 d, float2 q) {
+    float2 n;
+    if (q.x > 0.0 && q.y > 0.0) {
+        n = q / max(length(q), 0.0001);
+    } else if (q.x > q.y) {
+        n = float2(1.0, 0.0);
+    } else {
+        n = float2(0.0, 1.0);
+    }
+    float sx = d.x < 0.0 ? -1.0 : 1.0;
+    float sy = d.y < 0.0 ? -1.0 : 1.0;
+    return float2(n.x * sx, n.y * sy);
+}
+
+half4 main(float2 p) {
+    float2 c = float2((box.x + box.z) * 0.5, (box.y + box.w) * 0.5);
+    float2 h = float2((box.z - box.x) * 0.5, (box.w - box.y) * 0.5);
+    float2 d = p - c;
+    float2 q = abs(d) - h + float2(radius, radius);
+    float sd = length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - radius;
+    float edge = 1.0 - clamp(-sd / bevel, 0.0, 1.0);
+    float k = edge * edge * edge;
+    float2 n = outwardNormal(d, q);
+    float2 base = c + d * zoom;
+    float2 shift = n * (strength * k);
+    half cr = backdrop.eval(base + shift * (1.0 + aberration) + offset).r;
+    half cg = backdrop.eval(base + shift + offset).g;
+    half cb = backdrop.eval(base + shift * (1.0 - aberration) + offset).b;
+    half shade = 1.0 - rimShade * k;
+    return half4(cr * shade, cg * shade, cb * shade, 1.0);
+}
+"""
+    }
+}
