     private val hapticOnKeyPress by keyboardPrefs.hapticOnKeyPress
     private val hapticOnKeyUp by keyboardPrefs.hapticOnKeyUp
@@ -116,6 +124,12 @@ object InputFeedbacks {
             InputFeedbackMode.Disabled -> return
