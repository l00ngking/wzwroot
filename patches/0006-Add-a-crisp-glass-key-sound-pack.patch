+        if (soundPack == SoundPack.Glass) {
+            GlassSounds.init(appContext)
+            // 0 means "system default", which has no meaning for our own samples
+            GlassSounds.play(effect, if (soundOnKeyPressVolume == 0) 0.8f else soundOnKeyPressVolume / 100f)
+            return
+        }
         val fx = when (effect) {
             SoundEffect.Standard -> AudioManager.FX_KEYPRESS_STANDARD
             SoundEffect.SpaceBar -> AudioManager.FX_KEYPRESS_SPACEBAR
